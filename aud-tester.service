[Unit]
Description=AuD Tester Website
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AuD-Tester-Website

# Check PATH so Docker is found
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Set env here or in .env file
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=BIND_HOST=127.0.0.1
# EnvironmentFile=/home/ubuntu/AuD-Tester-Website/.env

ExecStart=/usr/local/bin/node server.js

Restart=on-failure
RestartSec=5
# Permissions for logs etc.
UMask=0027

# Logs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target