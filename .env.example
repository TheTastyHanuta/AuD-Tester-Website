PORT=3000
SHOW_SECRET_TESTS=true
FORCE_SHOW_SECRET_TESTS=false

# Session configuration
# Use a long random value. Required in production.
SESSION_SECRET=replace-with-a-long-random-secret
LOG_VIEWER_PASSWORD=change-this-password

# Logging configuration
LOG_LEVEL=info
NODE_ENV=development

# Docker sandbox configuration
JAVA_COMPILER_DOCKER_IMAGE=eclipse-temurin:17-jdk
JAVA_COMPILE_TIMEOUT_MS=60000
DOCKER_TEST_TIMEOUT_MS=120000
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=0.5
DOCKER_PIDS_LIMIT=100
